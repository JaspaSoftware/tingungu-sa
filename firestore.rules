rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Set the admin custom claim from a trusted server/Admin SDK, never from a client.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function mutableProfileFields() {
      return [
        'displayname',
        'display_name',
        'email',
        'cellnumber',
        'cellphone',
        'avatar',
        'society',
        'society_name',
        'dob',
        'profile_completed',
        'read_notices',
        'presence_status',
        'presence_active',
        'presence_updated_at'
      ];
    }

    function profileFields() {
      return mutableProfileFields().concat(['createdAt']);
    }
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(profileFields());
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(mutableProfileFields())
      );
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayname', 'avatar', 'society', 'society_name',
          'presence_status', 'presence_active', 'presence_updated_at'
        ]);
      allow delete: if isAdmin();
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /media/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /giving_options/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Societies now live in MySQL and are served by the authenticated API.
    // Info hub directory (districts, circuits, ministers...): public read, admin write.
    match /districts/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /circuits/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ministers/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /communities/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /givings/{givingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_settings/{documentId} {
      allow read, write: if isAdmin();
    }

    match /test_program_emails/{documentId} {
      allow read, write: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isAdmin();
    }
  }
}
